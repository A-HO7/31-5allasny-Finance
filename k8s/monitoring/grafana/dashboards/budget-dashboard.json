{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "description": "Observability dashboard for the Budget Service — error rates, Feign downstream health, RabbitMQ events, latency, and JVM metrics.",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Budget Service Error Rate per Minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count_over_time({app=\"financetracker\", service=\"budget-service\", level=\"ERROR\"}[1m])",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "id": 2,
      "title": "Feign Downstream Failures",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"budget-service\"} |= \"Feign call to\" | json | message=~ \"failed\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "RabbitMQ Event Audit",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"budget-service\"} | json | routingKey=~ \"budget.*\"",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_server_requests_seconds_count{job=\"budget-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "P99 Response Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job=\"budget-service\"}[5m]))",
          "legendFormat": "P99 {{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=\"budget-service\"}",
          "legendFormat": "Used Bytes"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["Finance Tracker", "budget-service", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Budget Service — Observability",
  "uid": "budget-service-obs",
  "version": 1
}
