{
  "title": "Account Service Dashboard",
  "uid": "account-service",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Error Rate — Account Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({app=\"financetracker\", service=\"account-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "errors/min"
        }
      ]
    },
    {
      "id": 2,
      "title": "Feign Call Outcomes — Account Service",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({app=\"financetracker\", service=\"account-service\"} |= \"Feign\" [5m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "RabbitMQ Event Audit — Account Service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "count_over_time({app=\"financetracker\", service=\"account-service\"} |= \"Published\" or |= \"Consuming\" or |= \"Processed\" [5m])",
          "legendFormat": "events/5m"
        }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s"
}