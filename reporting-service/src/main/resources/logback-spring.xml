<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Console appender (plain text for local dev / kubectl logs) ── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Loki4J appender — pushes JSON log streams to Loki ── -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://loki.monitoring.svc.cluster.local:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <!-- Labels must match exactly what LogQL panels query on -->
                <pattern>app=financetracker,service=reporting-service,level=%level,env=k8s</pattern>
            </label>
            <message>
                <pattern>{"timestamp":"%d{ISO8601}","level":"%level","service":"reporting-service","thread":"%thread","logger":"%logger{36}","correlationId":"%X{correlationId:-}","reportId":"%X{reportId:-}","transactionId":"%X{transactionId:-}","userId":"%X{userId:-}","routingKey":"%X{routingKey:-}","message":"%msg"}</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
        <batchMaxItems>1000</batchMaxItems>
        <batchTimeoutMs>1000</batchTimeoutMs>
        <sendQueueMaxBytes>41943040</sendQueueMaxBytes>
    </appender>

    <!-- ── Root logger: INFO to both appenders ── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

    <!-- Downgrade Spring/Hibernate noise so only business logs reach Loki -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate"       level="WARN"/>

    <!-- Reporting service at DEBUG so Feign call WARN/INFO log points flow -->
    <logger name="com.team31.financetracker.reporting" level="DEBUG"/>
    <logger name="feign"                               level="DEBUG"/>

</configuration>
